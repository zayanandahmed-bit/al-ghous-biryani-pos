{
  "name": "AL GHOUS BIRYANI - Review Watcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "id": "d4d4d4d4-0001-4000-8000-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://evolutionapi-evolution-api.lgf2ns.easypanel.host/chat/findMessages/A.P.I.S%20for%20Ali",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "4FF5997A30BD-4D28-AC34-33B281BBEFFE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"where\":{\"messageType\":\"pollUpdateMessage\"},\"limit\":500}",
        "options": {}
      },
      "id": "d4d4d4d4-0002-4000-8000-000000000002",
      "name": "Fetch poll votes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst records = (raw.messages && raw.messages.records) || [];\n\nconst latestByKey = {};\nfor (const m of records) {\n  const pu = m.message && m.message.pollUpdateMessage;\n  const vote = pu && pu.vote;\n  const pollKey = pu && pu.pollCreationMessageKey;\n  if (!vote || !vote.selectedOptions || !vote.selectedOptions.length || !pollKey) continue;\n  const keyObj = m.key || {};\n  const phone = (keyObj.remoteJidAlt || keyObj.remoteJid || '').split('@')[0];\n  const dedupeKey = phone + '|' + pollKey.id;\n  const ts = m.messageTimestamp || 0;\n  if (!latestByKey[dedupeKey] || ts > latestByKey[dedupeKey].ts) {\n    latestByKey[dedupeKey] = {\n      dedupeKey, ts, phone,\n      customer: (m.pushName || '').trim() || 'Unknown',\n      rating: vote.selectedOptions[0]\n    };\n  }\n}\n\n// Persisted across runs in this workflow's own static data -- no separate\n// database needed just to remember which votes were already announced.\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.notifiedKeys) staticData.notifiedKeys = [];\nconst notifiedSet = new Set(staticData.notifiedKeys);\n\nconst newReviews = Object.values(latestByKey).filter(r => !notifiedSet.has(r.dedupeKey));\n\n// Marked notified now, before the actual send, to keep this simple --\n// small risk of a missed notification if the run crashes mid-way, never a\n// duplicate one.\nnewReviews.forEach(r => staticData.notifiedKeys.push(r.dedupeKey));\nif (staticData.notifiedKeys.length > 2000) {\n  staticData.notifiedKeys = staticData.notifiedKeys.slice(-1000);\n}\n\nreturn newReviews.map(r => ({ json: r }));\n"
      },
      "id": "d4d4d4d4-0003-4000-8000-000000000003",
      "name": "Find new reviews",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ajevxwdgmpaakjkffvmf.supabase.co/rest/v1/rpc/get_customer_details_by_phone_agb",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFqZXZ4d2RnbXBhYWtqa2Zmdm1mIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUwNjE5NzIsImV4cCI6MjEwMDYzNzk3Mn0.bB97bHOFgCeMUTYUraOArzvXAkFRHxiajrCg3gwCGrc"
            },
            {
              "name": "Authorization",
              "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFqZXZ4d2RnbXBhYWtqa2Zmdm1mIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUwNjE5NzIsImV4cCI6MjEwMDYzNzk3Mn0.bB97bHOFgCeMUTYUraOArzvXAkFRHxiajrCg3gwCGrc"
            },
            {
