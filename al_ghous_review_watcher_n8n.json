      "id": "d4d4d4d4-0004-4000-8000-000000000004",
      "name": "Get customer details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const review = $('Find new reviews').item.json;\nconst details = $input.first().json;\n\nconst name = details.customer || review.customer || 'Unknown';\nconst address = details.address || 'N/A';\nconst when = new Date(review.ts * 1000).toLocaleString();\n\nconst text = `⭐ *New Review!*\n\nCustomer: ${name}\nPhone: ${review.phone}\nAddress: ${address}\nRating: ${review.rating}\nTime: ${when}`;\n\nreturn [{ json: { text: text } }];\n"
      },
      "id": "d4d4d4d4-0005-4000-8000-000000000005",
